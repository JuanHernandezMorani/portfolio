# Optional. If omitted, the contact form uses FormSubmit's no-key AJAX endpoint.
# Example: VITE_CONTACT_FORM_ENDPOINT=https://formsubmit.co/ajax/your-random-string
VITE_CONTACT_FORM_ENDPOINT=

# Build-time only. Required when sync:projects needs to read repositories that
# are private on GitHub. Never prefix this with VITE_ because VITE_* values can
# be included in the browser bundle.
GITHUB_TOKEN=

# Recommended for private repositories when the portfolio source itself is
# public. In the source JSON use: "githubRepoEnv": "GITHUB_REPO_MU_ONLINE"
# instead of writing the private repository slug directly.
GITHUB_REPO_MU_ONLINE=
